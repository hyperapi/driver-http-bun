{
	"name": "@hyperapi/driver-bun",
	"version": "0.5.0-dev",
	"description": "HyperAPI HTTP driver for Bun.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/main.js",
	"types": "dist/main.d.ts",
	"exports": {
		".": "./dist/main.js"
	},
	"engines": {
		"node": ">=21"
	},
	"peerDependencies": {
		"@hyperapi/core": "github:hyperapi/core#1aa5ffd2e603040e99f80f84b028a386ead5cca5",
		"@kirick/ip": "^0.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.1",
		"@kirick/lint": "0.2.12",
		"@types/bun": "1.2.23",
		"eslint": "9.38.0",
		"oxlint": "1.24.0",
		"publint": "0.3.15",
		"tsdown": "0.15.11",
		"typescript": "5.9.3",
		"unplugin-unused": "0.5.4",
		"valibot": "^1.1.0"
	},
	"scripts": {
		"build": "tsdown src/main.ts --clean --tsconfig tsconfig.main.json --publint --unused --dts --format esm",
		"check": "bun run lint && bun run build && bun run test",
		"lint": "biome format && oxlint && eslint . && tsc -b",
		"test": "bun test --coverage"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyperapi/driver-http-bun.git"
	},
	"keywords": [
		"hyperapi",
		"api",
		"driver",
		"hyperapi-driver",
		"http",
		"bun"
	],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/hyperapi/driver-http-bun/issues"
	},
	"homepage": "https://github.com/hyperapi/driver-http-bun#readme"
}
