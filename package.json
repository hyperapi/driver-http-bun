{
	"name": "@hyperapi/driver-bun",
	"version": "0.3.0-dev",
	"description": "HyperAPI HTTP driver for Bun.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/main.js",
	"types": "dist/main.d.ts",
	"exports": {
		".": "./dist/main.js"
	},
	"engines": {
		"node": ">=21"
	},
	"peerDependencies": {
		"@hyperapi/core": "github:hyperapi/core#30dc86f06f4960f43a17b5cb63b6bd57740ad8be",
		"@kirick/ip": "^0.1.1"
	},
	"devDependencies": {
		"@kirick/eslint-config": "^0.1.30",
		"@types/bun": "^1.2.13",
		"eslint": "9.10.0",
		"publint": "0.3.12",
		"tsdown": "0.12.2",
		"typescript": "5.8.3",
		"unplugin-unused": "0.5.0",
		"vitest": "3.1.4"
	},
	"scripts": {
		"build": "tsdown src/main.ts --publint --unused --dts --format esm",
		"check": "bun run build && bun run lint && bun run test",
		"lint": "eslint . && tsc",
		"test": "bun test --coverage"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyperapi/driver-http-bun.git"
	},
	"keywords": [
		"hyperapi",
		"api",
		"driver",
		"hyperapi-driver",
		"http",
		"bun"
	],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/hyperapi/driver-http-bun/issues"
	},
	"homepage": "https://github.com/hyperapi/driver-http-bun#readme"
}
