{
	"name": "@hyperapi/driver-bun",
	"version": "0.5.0-dev",
	"description": "HyperAPI HTTP driver for Bun.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/main.js",
	"types": "dist/main.d.ts",
	"exports": {
		".": "./dist/main.js"
	},
	"engines": {
		"node": ">=21"
	},
	"peerDependencies": {
		"@hyperapi/core": "github:hyperapi/core#fda360853e4fdd986bedc7e275e11241fd62140e",
		"@kirick/ip": "^0.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.1.1",
		"@kirick/lint": "0.2.8",
		"@types/bun": "^1.2",
		"eslint": "9.27.0",
		"oxlint": "1.3.0",
		"publint": "0.3.12",
		"tsdown": "0.14.2",
		"typescript": "5.9.2",
		"unplugin-unused": "0.5.2",
		"valibot": "^1.1.0",
		"vitest": "3.2.4"
	},
	"scripts": {
		"build": "tsdown src/main.ts --publint --unused --dts --format esm",
		"check": "bun run lint && bun run build && bun run test",
		"lint": "biome format && oxlint && eslint . && tsc",
		"test": "bun test --coverage"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyperapi/driver-http-bun.git"
	},
	"keywords": [
		"hyperapi",
		"api",
		"driver",
		"hyperapi-driver",
		"http",
		"bun"
	],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/hyperapi/driver-http-bun/issues"
	},
	"homepage": "https://github.com/hyperapi/driver-http-bun#readme"
}
