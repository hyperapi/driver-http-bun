{
	"name": "@hyperapi/driver-bun",
	"version": "0.7.0-dev",
	"description": "HyperAPI HTTP driver for Bun.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"files": [
		"dist/"
	],
	"exports": {
		".": {
			"types": "./dist/main.d.mts",
			"import": "./dist/main.mjs"
		}
	},
	"engines": {
		"node": ">=21"
	},
	"peerDependencies": {
		"@hyperapi/core": "github:hyperapi/core#daac5df164cba7ce5f2638afef5dc13659d4f1c0",
		"@kirick/ip": "^0.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.4",
		"@kirick/lint": "0.4.2",
		"@types/bun": "1.4.2",
		"eslint": "10.7.0",
		"oxlint": "1.74.0",
		"publint": "0.3.21",
		"tsdown": "0.22.3",
		"typescript": "6.0.3",
		"unplugin-unused": "0.5.7",
		"valibot": "1.5.0"
	},
	"_devpack": {
		"@hyperapi/core": "../core"
	},
	"scripts": {
		"build": "tsdown src/main.ts --clean --publint --unused --dts --format esm",
		"check": "lint && bun run test && bun run build",
		"test": "bun test --coverage"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyperapi/driver-http-bun.git"
	},
	"keywords": [
		"hyperapi",
		"api",
		"driver",
		"hyperapi-driver",
		"http",
		"bun"
	],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/hyperapi/driver-http-bun/issues"
	},
	"homepage": "https://github.com/hyperapi/driver-http-bun#readme"
}
