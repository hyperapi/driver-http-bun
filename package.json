{
	"name": "@hyperapi/driver-bun",
	"version": "0.3.0-dev",
	"description": "HyperAPI HTTP driver for Bun.",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/esm/main.js",
	"types": "dist/esm/main.d.ts",
	"exports": {
		".": {
			"import": "./dist/esm/main.js",
			"require": "./dist/main.cjs"
		}
	},
	"engines": {
		"node": ">=21"
	},
	"dependencies": {
		"@kirick/ip": "^0.1.1"
	},
	"peerDependencies": {
		"@hyperapi/core": "github:hyperapi/core#ca15b2c93608f45161267612ddc473dbe55d61f0"
	},
	"devDependencies": {
		"@kirick/eslint-config": "^0.1.30",
		"@types/bun": "^1.1.8",
		"eslint": "9.10.0",
		"typescript": "5.5.4"
	},
	"scripts": {
		"build": "bun run build:ts && bun run build:cjs",
		"build:cjs": "bun build dist/esm/main.js --platform=node --format=cjs --packages=external --outfile=dist/main.cjs",
		"# build:cjs": "bunx esbuild --bundle --platform=node --format=cjs --packages=external --outfile=dist/main.cjs dist/esm/main.js",
		"build:ts": "rm -rf dist/esm dist/types ; tsc",
		"check": "bun run build && bun run lint && bun run test",
		"lint": "eslint . && tsc --skipLibCheck --noemit",
		"test": "bun test --coverage"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyperapi/driver-http-bun.git"
	},
	"keywords": [
		"hyperapi",
		"api",
		"driver",
		"hyperapi-driver",
		"http",
		"bun"
	],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/hyperapi/driver-http-bun/issues"
	},
	"homepage": "https://github.com/hyperapi/driver-http-bun#readme"
}
